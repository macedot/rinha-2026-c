# Deny all
/*

# Allow project files
!.gitignore
!LICENSE
!Makefile
!Dockerfile
!docker-compose.yml
!haproxy.cfg
!info.json
!autoresearch.sh
!README.md

# Allow source code
!src/
!src/*.c
!src/*.h

# Allow indexer
!indexer/
!indexer/*.c
!indexer/Makefile

# Allow tests
!test/
!test/*.c
!test/test.js

# Allow resources (reference data, but not the huge index.bin)
!resources/
!resources/mcc_risk.json
!resources/references.json.gz
!resources/example-payloads.json
!resources/example-references.json
resources/index.bin

# Allow data (pre-built index)
!data/
!data/*.bin

# Allow CI
!.github/
!.github/**/*
